{
  "name": "vscode-agent-tracing",
  "displayName": "Agent Tracing",
  "description": "Local-first observability for AI coding agents. One-click setup for tracing VS Code Copilot and Claude sessions with pluggable backends like Langfuse.",
  "version": "0.1.3",
  "publisher": "zhichli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhichli/vscode-agent-tracing"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "langfuse",
    "observability",
    "tracing",
    "copilot",
    "claude",
    "agent",
    "hooks",
    "claude-code"
  ],
  "icon": "resources/icons/agent-tracing-128.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "pricing": "Free",
  "telemetryConnectionString": "",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTracing",
          "title": "Agent Tracing",
          "icon": "resources/icons/agent-tracing.svg"
        }
      ]
    },
    "views": {
      "agentTracing": [
        {
          "id": "agentTracing.solutions",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "agentTracing.setup",
        "category": "Agent Tracing",
        "title": "Start",
        "shortTitle": "Start Langfuse and enable tracing",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.startStack",
        "category": "Agent Tracing",
        "title": "Start",
        "shortTitle": "Start Langfuse stack (docker compose up)",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.stopStack",
        "category": "Agent Tracing",
        "title": "Stop Stack",
        "shortTitle": "Stop Langfuse stack (data preserved)",
        "icon": "$(primitive-square)"
      },
      {
        "command": "agentTracing.recreateStack",
        "category": "Agent Tracing",
        "title": "Recreate Stack",
        "shortTitle": "Recreate — rebuild containers, keep trace data",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentTracing.purgeStack",
        "category": "Agent Tracing",
        "title": "Delete Stack",
        "shortTitle": "Delete — remove containers + all trace data",
        "icon": "$(trash)"
      },
      {
        "command": "agentTracing.openDashboard",
        "category": "Agent Tracing",
        "title": "Open Dashboard",
        "shortTitle": "Open Langfuse dashboard in VS Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentTracing.openDashboardExternal",
        "category": "Agent Tracing",
        "title": "Open Dashboard (External Browser)",
        "shortTitle": "Open Langfuse dashboard in system browser",
        "icon": "$(link-external)"
      },
      {
        "command": "agentTracing.showLoginInfo",
        "category": "Agent Tracing",
        "title": "Login Info",
        "shortTitle": "Show Langfuse login email and password",
        "icon": "$(key)"
      },
      {
        "command": "agentTracing.refresh",
        "category": "Agent Tracing",
        "title": "Refresh",
        "shortTitle": "Refresh status",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTracing.enableHook",
        "category": "Agent Tracing",
        "title": "Enable Hooks",
        "shortTitle": "Enable tracing hooks for all agents",
        "icon": "$(plug)"
      },
      {
        "command": "agentTracing.disableHook",
        "category": "Agent Tracing",
        "title": "Disable Hooks",
        "shortTitle": "Disable tracing hooks (script stays on disk)",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentTracing.connectExternal",
        "category": "Agent Tracing",
        "title": "Connect to Existing Langfuse",
        "shortTitle": "Connect to a running Langfuse instance",
        "icon": "$(plug)"
      },
      {
        "command": "agentTracing.disconnect",
        "category": "Agent Tracing",
        "title": "Disconnect External Langfuse",
        "shortTitle": "Disconnect from external Langfuse",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentTracing.showStackVersion",
        "category": "Agent Tracing",
        "title": "Stack Info",
        "shortTitle": "Show pinned Docker image versions",
        "icon": "$(info)"
      },
      {
        "command": "agentTracing.showHookLog",
        "category": "Agent Tracing",
        "title": "Show Hook Log",
        "shortTitle": "Open the hook script log for debugging",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTracing.refresh",
          "when": "view == agentTracing.solutions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-not-configured",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-docker-not-found",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running.*hooks-off$/",
          "group": "inline@0"
        },
        {
          "command": "agentTracing.openDashboard",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.disableHook",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running.*hooks-on$/",
          "group": "langfuse@5"
        },
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running.*hooks-off$/",
          "group": "langfuse@5"
        },
        {
          "command": "agentTracing.stopStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "inline@3"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "inline@3"
        },
        {
          "command": "agentTracing.openDashboardExternal",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "langfuse@1"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "langfuse@2"
        },
        {
          "command": "agentTracing.showLoginInfo",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "langfuse@3"
        },
        {
          "command": "agentTracing.showStackVersion",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "langfuse@4"
        },
        {
          "command": "agentTracing.showHookLog",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running|stopped)/",
          "group": "langfuse@6"
        },
        {
          "command": "agentTracing.recreateStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "langfuse-danger@1"
        },
        {
          "command": "agentTracing.purgeStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "langfuse-danger@2"
        },
        {
          "command": "agentTracing.startStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-stopped/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.disableHook",
          "when": "view == agentTracing.solutions && viewItem == langfuse-stopped-hooks-on",
          "group": "langfuse@5"
        },
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && viewItem == langfuse-stopped-hooks-off",
          "group": "langfuse@5"
        }
      ]
    },
    "configuration": {
      "title": "Agent Tracing",
      "properties": {
        "agentTracing.langfuse.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Langfuse dashboard (localhost)"
        },
        "agentTracing.langfuse.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Langfuse when VS Code opens"
        },
        "agentTracing.additionalExporters": {
          "type": "array",
          "default": [],
          "markdownDescription": "Additional OTLP trace exporters. Each entry sends traces to an OTLP-compatible backend alongside Langfuse.\n\nExample for Jaeger:\n```json\n[{ \"name\": \"jaeger\", \"endpoint\": \"http://localhost:4318/v1/traces\" }]\n```",
          "items": {
            "type": "object",
            "required": ["name", "endpoint"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this exporter (e.g. 'jaeger', 'honeycomb')"
              },
              "endpoint": {
                "type": "string",
                "description": "OTLP HTTP/JSON endpoint URL (e.g. http://localhost:4318/v1/traces)"
              },
              "headers": {
                "type": "object",
                "description": "Additional HTTP headers (e.g. Authorization, api-key)",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^1.5.0"
  }
}
