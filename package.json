{
  "name": "vscode-agent-tracing",
  "displayName": "Agent Tracing",
  "description": "Local-first observability for AI coding agents. One-click setup for tracing VS Code Copilot and Claude sessions with pluggable backends like Langfuse.",
  "version": "0.1.0",
  "publisher": "zhichli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhichli/vscode-agent-tracing"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "langfuse",
    "observability",
    "tracing",
    "copilot",
    "claude",
    "agent",
    "hooks",
    "claude-code"
  ],
  "icon": "resources/icons/agent-tracing-128.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTracing",
          "title": "Agent Tracing",
          "icon": "resources/icons/agent-tracing.svg"
        }
      ]
    },
    "views": {
      "agentTracing": [
        {
          "id": "agentTracing.solutions",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "agentTracing.setup",
        "title": "Agent Tracing: Full Setup",
        "shortTitle": "Setup",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.startStack",
        "title": "Agent Tracing: Start Stack",
        "shortTitle": "Start",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.stopStack",
        "title": "Agent Tracing: Stop Stack",
        "shortTitle": "Stop",
        "icon": "$(primitive-square)"
      },
      {
        "command": "agentTracing.openDashboard",
        "title": "Agent Tracing: Open Dashboard (Integrated Browser)",
        "shortTitle": "Open Dashboard",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentTracing.openDashboardExternal",
        "title": "Agent Tracing: Open Dashboard (External Browser)",
        "shortTitle": "Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "agentTracing.showLoginInfo",
        "title": "Agent Tracing: Show Login Info",
        "shortTitle": "Login Info",
        "icon": "$(key)"
      },
      {
        "command": "agentTracing.refresh",
        "title": "Agent Tracing: Refresh",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTracing.enableHook",
        "title": "Agent Tracing: Enable Hooks",
        "shortTitle": "Enable Hooks",
        "icon": "$(broadcast)"
      },
      {
        "command": "agentTracing.disableHook",
        "title": "Agent Tracing: Disable Hooks",
        "shortTitle": "Disable Hooks",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agentTracing.connectExternal",
        "title": "Agent Tracing: Connect to Existing Langfuse",
        "shortTitle": "Connect External",
        "icon": "$(plug)"
      },
      {
        "command": "agentTracing.disconnect",
        "title": "Agent Tracing: Disconnect External Langfuse",
        "shortTitle": "Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentTracing.showStackVersion",
        "title": "Agent Tracing: Show Stack Version",
        "shortTitle": "Stack Version",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTracing.refresh",
          "when": "view == agentTracing.solutions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-not-configured",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.connectExternal",
          "when": "view == agentTracing.solutions && viewItem == langfuse-not-configured",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-docker-not-found",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.connectExternal",
          "when": "view == agentTracing.solutions && viewItem == langfuse-docker-not-found",
          "group": "inline@2"
        },

        {
          "command": "agentTracing.openDashboard",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.disableHook",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running.*hooks-on$/",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running.*hooks-off$/",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.stopStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "inline@3"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "inline@3"
        },

        {
          "command": "agentTracing.openDashboardExternal",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "langfuse@1"
        },
        {
          "command": "agentTracing.stopStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "langfuse@2"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "langfuse@2"
        },
        {
          "command": "agentTracing.showLoginInfo",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "langfuse@3"
        },
        {
          "command": "agentTracing.showStackVersion",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "langfuse@4"
        },

        {
          "command": "agentTracing.startStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-stopped/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.disableHook",
          "when": "view == agentTracing.solutions && viewItem == langfuse-stopped-hooks-on",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && viewItem == langfuse-stopped-hooks-off",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.connectExternal",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-stopped/",
          "group": "langfuse@3"
        }
      ]
    },
    "configuration": {
      "title": "Agent Tracing",
      "properties": {
        "agentTracing.langfuse.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Langfuse dashboard (localhost)"
        },
        "agentTracing.langfuse.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Langfuse when VS Code opens"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
