{
  "name": "vscode-agent-tracing",
  "displayName": "Agent Tracing",
  "description": "Local-first observability for AI coding agents. One-click setup for tracing VS Code Copilot and Claude sessions with pluggable backends like Langfuse.",
  "version": "0.2.0",
  "publisher": "zhichli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhichli/vscode-agent-tracing"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "langfuse",
    "observability",
    "tracing",
    "copilot",
    "claude",
    "agent",
    "hooks",
    "claude-code"
  ],
  "icon": "resources/icons/agent-tracing-128.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "pricing": "Free",
  "telemetryConnectionString": "",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTracing",
          "title": "Agent Tracing",
          "icon": "resources/icons/agent-tracing.svg"
        }
      ]
    },
    "views": {
      "agentTracing": [
        {
          "id": "agentTracing.solutions",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "agentTracing.setup",
        "category": "Agent Tracing",
        "title": "Start",
        "shortTitle": "Start Langfuse and enable tracing",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.startStack",
        "category": "Agent Tracing",
        "title": "Start",
        "shortTitle": "Start Langfuse stack (docker compose up)",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.stopStack",
        "category": "Agent Tracing",
        "title": "Stack: Stop",
        "shortTitle": "Stop Langfuse stack (data preserved)",
        "icon": "$(primitive-square)"
      },
      {
        "command": "agentTracing.recreateStack",
        "category": "Agent Tracing",
        "title": "Stack: Recreate",
        "shortTitle": "Recreate — rebuild containers, keep trace data",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentTracing.purgeStack",
        "category": "Agent Tracing",
        "title": "Stack: Delete",
        "shortTitle": "Delete — remove containers + all trace data",
        "icon": "$(trash)"
      },
      {
        "command": "agentTracing.openDashboard",
        "category": "Agent Tracing",
        "title": "Open Dashboard",
        "shortTitle": "Open Langfuse dashboard in VS Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentTracing.openDashboardExternal",
        "category": "Agent Tracing",
        "title": "Dashboard: Open in External Browser",
        "shortTitle": "Open Langfuse dashboard in system browser",
        "icon": "$(link-external)"
      },
      {
        "command": "agentTracing.showLoginInfo",
        "category": "Agent Tracing",
        "title": "Info: Login Credentials",
        "shortTitle": "Show Langfuse login email and password",
        "icon": "$(account)"
      },
      {
        "command": "agentTracing.refresh",
        "category": "Agent Tracing",
        "title": "Refresh",
        "shortTitle": "Refresh status",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTracing.enableHook",
        "category": "Agent Tracing",
        "title": "Hook: Install",
        "shortTitle": "Install tracing hooks in ~/.claude/settings.json",
        "icon": "$(plug)"
      },
      {
        "command": "agentTracing.disableHook",
        "category": "Agent Tracing",
        "title": "Hook: Uninstall",
        "shortTitle": "Remove tracing hooks from ~/.claude/settings.json",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentTracing.connectExternal",
        "category": "Agent Tracing",
        "title": "Connect to Existing Langfuse",
        "shortTitle": "Connect to a running Langfuse instance",
        "icon": "$(plug)"
      },
      {
        "command": "agentTracing.disconnect",
        "category": "Agent Tracing",
        "title": "Dashboard: Disconnect",
        "shortTitle": "Disconnect from external Langfuse",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentTracing.showStackVersion",
        "category": "Agent Tracing",
        "title": "Info: Stack Versions",
        "shortTitle": "Show pinned Docker image versions",
        "icon": "$(info)"
      },
      {
        "command": "agentTracing.enableHookSettings",
        "category": "Agent Tracing",
        "title": "Hook: Enable VS Code Settings",
        "shortTitle": "Enable chat.useHooks & chat.useClaudeHooks",
        "icon": "$(gear)"
      },
      {
        "command": "agentTracing.showHookLog",
        "category": "Agent Tracing",
        "title": "Hook: Show Log",
        "shortTitle": "Open the hook script log for debugging",
        "icon": "$(file-text)"
      },
      {
        "command": "agentTracing.jaeger.setup",
        "category": "Agent Tracing",
        "title": "Start Jaeger",
        "shortTitle": "Pull and start a Jaeger container",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.jaeger.start",
        "category": "Agent Tracing",
        "title": "Start Jaeger",
        "shortTitle": "Start existing Jaeger container",
        "icon": "$(play)"
      },
      {
        "command": "agentTracing.jaeger.stop",
        "category": "Agent Tracing",
        "title": "Stack: Stop",
        "shortTitle": "Stop the Jaeger container",
        "icon": "$(primitive-square)"
      },
      {
        "command": "agentTracing.jaeger.purge",
        "category": "Agent Tracing",
        "title": "Stack: Delete",
        "shortTitle": "Remove Jaeger container and data",
        "icon": "$(trash)"
      },
      {
        "command": "agentTracing.jaeger.recreate",
        "category": "Agent Tracing",
        "title": "Stack: Recreate",
        "shortTitle": "Recreate Jaeger container",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentTracing.jaeger.openDashboard",
        "category": "Agent Tracing",
        "title": "Open Jaeger Dashboard",
        "shortTitle": "Open Jaeger UI in VS Code",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentTracing.jaeger.openDashboardExternal",
        "category": "Agent Tracing",
        "title": "Dashboard: Open in External Browser",
        "shortTitle": "Open Jaeger UI in system browser",
        "icon": "$(link-external)"
      },
      {
        "command": "agentTracing.jaeger.showStackVersion",
        "category": "Agent Tracing",
        "title": "Info: Jaeger Stack Versions",
        "shortTitle": "Show Jaeger image and endpoint versions",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTracing.enableHook",
          "when": "view == agentTracing.solutions && !agentTracing.hooksInstalled",
          "group": "navigation@0"
        },
        {
          "command": "agentTracing.disableHook",
          "when": "view == agentTracing.solutions && agentTracing.hooksInstalled",
          "group": "navigation@0"
        },
        {
          "command": "agentTracing.enableHookSettings",
          "when": "view == agentTracing.solutions && agentTracing.hookSettingsMissing",
          "group": "navigation@1"
        },
        {
          "command": "agentTracing.refresh",
          "when": "view == agentTracing.solutions",
          "group": "navigation@9"
        },
        {
          "command": "agentTracing.showHookLog",
          "when": "view == agentTracing.solutions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-not-configured",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.setup",
          "when": "view == agentTracing.solutions && viewItem == langfuse-docker-not-found",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.enableHookSettings",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-.*hooks-settings-off$/",
          "group": "inline@0"
        },
        {
          "command": "agentTracing.openDashboard",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.showLoginInfo",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "inline@2"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "inline@3"
        },
        {
          "command": "agentTracing.startStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-stopped/",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.openDashboardExternal",
          "when": "view == agentTracing.solutions && viewItem =~ /langfuse-running/",
          "group": "lf-1-browse@1"
        },
        {
          "command": "agentTracing.disconnect",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-external/",
          "group": "lf-1-browse@2"
        },
        {
          "command": "agentTracing.showStackVersion",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "lf-2-info@1"
        },
        {
          "command": "agentTracing.enableHookSettings",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-.*hooks-settings-off$/",
          "group": "lf-3-hooks@1"
        },
        {
          "command": "agentTracing.stopStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-running-hooks/",
          "group": "lf-4-danger@1"
        },
        {
          "command": "agentTracing.recreateStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "lf-4-danger@2"
        },
        {
          "command": "agentTracing.purgeStack",
          "when": "view == agentTracing.solutions && viewItem =~ /^langfuse-(running-hooks|stopped)/",
          "group": "lf-4-danger@3"
        },
        {
          "command": "agentTracing.jaeger.setup",
          "when": "view == agentTracing.solutions && viewItem == jaeger-not-configured",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.jaeger.setup",
          "when": "view == agentTracing.solutions && viewItem == jaeger-docker-not-found",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.jaeger.openDashboard",
          "when": "view == agentTracing.solutions && viewItem == jaeger-running",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.jaeger.start",
          "when": "view == agentTracing.solutions && viewItem == jaeger-stopped",
          "group": "inline@1"
        },
        {
          "command": "agentTracing.jaeger.openDashboardExternal",
          "when": "view == agentTracing.solutions && viewItem == jaeger-running",
          "group": "jg-1-browse@1"
        },
        {
          "command": "agentTracing.jaeger.showStackVersion",
          "when": "view == agentTracing.solutions && viewItem =~ /^jaeger-(running|stopped)/",
          "group": "jg-2-info@1"
        },
        {
          "command": "agentTracing.enableHookSettings",
          "when": "view == agentTracing.solutions && agentTracing.hookSettingsMissing && viewItem =~ /^jaeger-(running|stopped)/",
          "group": "jg-3-hooks@1"
        },
        {
          "command": "agentTracing.jaeger.stop",
          "when": "view == agentTracing.solutions && viewItem == jaeger-running",
          "group": "jg-4-danger@1"
        },
        {
          "command": "agentTracing.jaeger.recreate",
          "when": "view == agentTracing.solutions && viewItem =~ /^jaeger-(running|stopped)/",
          "group": "jg-4-danger@2"
        },
        {
          "command": "agentTracing.jaeger.purge",
          "when": "view == agentTracing.solutions && viewItem =~ /^jaeger-(running|stopped)/",
          "group": "jg-4-danger@3"
        }
      ]
    },
    "configuration": {
      "title": "Agent Tracing",
      "properties": {
        "agentTracing.langfuse.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Langfuse dashboard (localhost)"
        },
        "agentTracing.langfuse.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Langfuse when VS Code opens"
        },
        "agentTracing.additionalExporters": {
          "type": "array",
          "default": [],
          "markdownDescription": "Additional OTLP trace exporters. Each entry sends traces to an OTLP-compatible backend alongside Langfuse.\n\nExample for Jaeger:\n```json\n[{ \"name\": \"jaeger\", \"endpoint\": \"http://localhost:4318/v1/traces\" }]\n```",
          "items": {
            "type": "object",
            "required": [
              "name",
              "endpoint"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this exporter (e.g. 'jaeger', 'honeycomb')"
              },
              "endpoint": {
                "type": "string",
                "description": "OTLP HTTP/JSON endpoint URL (e.g. http://localhost:4318/v1/traces)"
              },
              "headers": {
                "type": "object",
                "description": "Additional HTTP headers (e.g. Authorization, api-key)",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "agentTracing.jaeger.uiPort": {
          "type": "number",
          "default": 16686,
          "description": "Port for the Jaeger UI (localhost)"
        },
        "agentTracing.jaeger.otlpPort": {
          "type": "number",
          "default": 4318,
          "description": "Port for the Jaeger OTLP HTTP receiver (localhost)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^1.5.0"
  }
}
